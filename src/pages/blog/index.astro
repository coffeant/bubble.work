---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.date) - new Date(a.data.date)
);
---

<Layout title="外贸获客博客 | 外贸工厂 AI 获客陪跑" description="外贸工厂获客知识：海关数据、独立站SEO/AEO、WhatsApp引流、AI获客实战技巧。">
  <main>
    <section style="padding:80px 0 40px;text-align:center;background:var(--bg-soft);border-bottom:1px solid var(--line);">
      <div class="wrap">
        <h1 style="font-size:clamp(30px,4.5vw,46px);margin-bottom:12px;">外贸获客<span class="grad-text">知识库</span></h1>
        <p style="color:var(--muted);font-size:17px;max-width:600px;margin:0 auto;">海关数据、独立站 SEO/AEO、WhatsApp 引流、AI 获客实战——给外贸工厂的实操方法。</p>
      </div>
    </section>

    <section style="padding:56px 0 96px;">
      <div class="wrap">
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:28px;">
          {posts.map((post) => (
            <a href={`/blog/${post.id.replace(/\.md$/, "")}/`} style="text-decoration:none;display:block;" class="card">
              {post.data.cover && (
                <img
                  src={post.data.cover}
                  alt={post.data.title}
                  style="width:100%;height:190px;object-fit:cover;border-radius:12px;margin-bottom:18px;"
                  loading="lazy"
                />
              )}
              <span style="display:inline-block;font-size:12px;color:var(--primary);font-weight:700;background:#eef2ff;padding:4px 10px;border-radius:6px;margin-bottom:12px;">{post.data.tag}</span>
              <h3 style="font-size:20px;margin-bottom:10px;">{post.data.title}</h3>
              <p style="color:var(--muted);font-size:14px;line-height:1.6;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;">{post.data.description}</p>
              <div style="margin-top:14px;color:var(--primary);font-weight:600;font-size:14px;">阅读全文 →</div>
              <div style="margin-top:6px;color:var(--muted);font-size:13px;">{post.data.date.toLocaleDateString("zh-CN")}</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>