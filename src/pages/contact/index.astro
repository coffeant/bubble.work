---
import Layout from "../../layouts/Layout.astro";

const wa = "https://wa.me/8618526821975";
const waMsg = "https://wa.me/8618526821975?text=" + encodeURIComponent("你好，我想了解外贸获客陪跑服务，我的产品是：");
const formspreeId = "YOUR_FORMSPREE_ID"; // 用户需要替换为自己的 Formspree ID
---

<Layout title="联系我们 | 外贸工厂 AI 获客陪跑" description="联系外贸工厂 AI 获客陪跑服务：WhatsApp +86 185 2682 1975，或添加微信咨询。">
  <main>
    <section style="padding:80px 0 40px;text-align:center;background:var(--bg-soft);border-bottom:1px solid var(--line);">
      <div class="wrap">
        <h1 style="font-size:clamp(30px,4.5vw,46px);margin-bottom:12px;">联系<span class="grad-text">我们</span></h1>
        <p style="color:var(--muted);font-size:17px;max-width:560px;margin:0 auto;">告诉我你的产品，我帮你评估这套系统能不能帮你出单。平均 24 小时内回复。</p>
      </div>
    </section>

    <section class="section">
      <div class="wrap" style="max-width:960px;">
        <div class="grid2">
          <a class="contact-card" href={waMsg} target="_blank" rel="noreferrer" style="background:var(--bg);border:1px solid var(--line);border-radius:var(--radius);padding:32px;text-align:center;text-decoration:none;transition:transform .2s,box-shadow .2s;display:block;">
            <div style="font-size:44px;margin-bottom:16px;">💬</div>
            <div style="font-size:13px;color:var(--muted);margin-bottom:8px;font-weight:500;">WhatsApp</div>
            <div style="font-size:22px;font-weight:700;color:var(--ink);margin-bottom:12px;">+86 185 2682 1975</div>
            <div style="display:inline-block;background:linear-gradient(120deg,#25d366,#1ebe5d);color:#fff;font-weight:600;font-size:14px;padding:10px 22px;border-radius:10px;">点击直达对话</div>
          </a>

          <div style="background:var(--bg);border:1px solid var(--line);border-radius:var(--radius);padding:32px;text-align:center;">
            <div style="font-size:44px;margin-bottom:16px;">💚</div>
            <div style="font-size:13px;color:var(--muted);margin-bottom:8px;font-weight:500;">微信</div>
            <div style="font-size:22px;font-weight:700;color:var(--ink);margin-bottom:16px;">添加后说明来意</div>
            <div style="width:130px;height:130px;margin:0 auto;border-radius:14px;background:linear-gradient(135deg,#eef2ff,#f5f3ff);display:flex;align-items:center;justify-content:center;color:#94a3b8;font-size:13px;">← 微信二维码<br />(发布时替换图片)</div>
          </div>
        </div>

        <div style="text-align:center;margin-top:36px;color:var(--muted);font-size:15px;">
          添加时请备注你的<strong>行业 + 产品</strong>，我按你的情况给建议
          <div style="margin-top:8px;">支持远程协助</div>
        </div>
      </div>
    </section>

    <!-- 免费外贸获客优化报告表单 -->
    <section class="section" style="background:var(--bg-soft);">
      <div class="wrap" style="max-width:640px;">
        <h2 style="text-align:center;margin-bottom:8px;">免费外贸获客<span class="grad-text">优化报告</span></h2>
        <p style="text-align:center;color:var(--muted);margin-bottom:32px;">填写以下信息，我将为你定制一份专属的外贸获客优化方案</p>
        
        <form 
          id="report-form"
          action={`https://formspree.io/f/${formspreeId}`}
          method="POST"
          style="background:var(--bg);border:1px solid var(--line);border-radius:var(--radius);padding:32px;"
        >
          <input type="hidden" name="_subject" value="外贸获客优化报告申请" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_next" value={Astro.url.href} />
          
          <div style="margin-bottom:20px;">
            <label for="company" style="display:block;font-size:14px;font-weight:600;margin-bottom:6px;color:var(--ink);">公司名称 *</label>
            <input type="text" id="company" name="company" required placeholder="例如：宁波海天进出口有限公司" style="width:100%;padding:12px 16px;border:1px solid var(--line);border-radius:8px;font-size:15px;background:var(--bg-soft);" />
          </div>
          
          <div style="margin-bottom:20px;">
            <label for="phone" style="display:block;font-size:14px;font-weight:600;margin-bottom:6px;color:var(--ink);">手机号 *</label>
            <input type="tel" id="phone" name="phone" required placeholder="你的手机号码" style="width:100%;padding:12px 16px;border:1px solid var(--line);border-radius:8px;font-size:15px;background:var(--bg-soft);" />
          </div>
          
          <div style="margin-bottom:20px;">
            <label for="email" style="display:block;font-size:14px;font-weight:600;margin-bottom:6px;color:var(--ink);">邮箱 *</label>
            <input type="email" id="email" name="email" required placeholder="your@email.com" style="width:100%;padding:12px 16px;border:1px solid var(--line);border-radius:8px;font-size:15px;background:var(--bg-soft);" />
          </div>
          
          <div style="margin-bottom:24px;">
            <label for="pain" style="display:block;font-size:14px;font-weight:600;margin-bottom:6px;color:var(--ink);">当前获客痛点 *</label>
            <textarea id="pain" name="pain" required rows="4" placeholder="请描述你目前在外贸获客方面遇到的主要问题，例如：找不到精准客户、独立站没流量、询盘转化率低等" style="width:100%;padding:12px 16px;border:1px solid var(--line);border-radius:8px;font-size:15px;background:var(--bg-soft);resize:vertical;"></textarea>
          </div>
          
          <button type="submit" style="width:100%;padding:14px;background:linear-gradient(120deg,var(--primary),var(--primary-hover));color:#fff;font-weight:700;font-size:16px;border:none;border-radius:10px;cursor:pointer;transition:transform .15s;">
            免费获取优化报告 →
          </button>
          
          <p style="text-align:center;font-size:12px;color:var(--muted);margin-top:12px;">提交后 24 小时内发送到你的邮箱</p>
        </form>
      </div>
    </section>
  </main>
</Layout>

<script>
  const form = document.getElementById("report-form") as HTMLFormElement;
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { "Accept": "application/json" }
        });
        if (response.ok) {
          form.innerHTML = `
            <div style="text-align:center;padding:40px 20px;">
              <div style="font-size:48px;margin-bottom:16px;">✅</div>
              <h3 style="margin-bottom:8px;">提交成功！</h3>
              <p style="color:var(--muted);">我们将在 24 小时内将优化报告发送到你的邮箱</p>
            </div>
          `;
        } else {
          throw new Error("Submission failed");
        }
      } catch (error) {
        alert("提交失败，请稍后重试或直接 WhatsApp 联系我");
      }
    });
  }
</script>